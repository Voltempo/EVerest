# Template for .devcontainer/monta-credentials.env, which is gitignored and must stay that way -
# these are live CSMS credentials.
#
# Copy this file to monta-credentials.env, fill it in, then run ./.devcontainer/monta-setup.sh.
#
# Create three charge points in the CSMS first, one per vSECC board. The real charger has one vSECC
# per two connectors, so a six-connector charger is three separate OCPP identities - there is no way
# to present it as one, and connector ids restart at 1 on each board.
#
# Each charge point needs OCPP 1.6J and a security profile of 2 (TLS with basic auth), which is what
# the template sets. The CSMS issues one authorisation key per charge point; they are not
# interchangeable.

MONTA_CP_1=MYNAME_EVEREST_1
MONTA_KEY_1=

MONTA_CP_2=MYNAME_EVEREST_2
MONTA_KEY_2=

MONTA_CP_3=MYNAME_EVEREST_3
MONTA_KEY_3=

# Optional - defaults to Monta production.
# MONTA_URI=wss://ocpp.monta.app
