# Template for .devcontainer/.env - copy to .env and edit, or generate with:
#   ./applications/devrd/devrd env
#
# .env itself is gitignored because UID, GID and HOST_WORKSPACE_FOLDER are specific to
# your machine. Committing it would break everyone else.

ORGANIZATION_ARG=EVerest
REPOSITORY_HOST=github.com
REPOSITORY_USER=git

# Commit of EVerest/everest-dev-environment to pin the dev tooling to.
# devrd resolves this with:
#   git ls-remote https://github.com/EVerest/everest-dev-environment.git main | cut -f1
COMMIT_HASH=
EVEREST_TOOL_BRANCH=main

# Your host user. Linux/macOS: run `id -u` and `id -g` (typically 1000).
# Windows Git Bash reports a large synthetic value - use whatever `id -u` prints.
UID=1000
GID=1000

# Absolute path to this repository, in the form your shell reports via `pwd`.
# Git Bash on Windows uses forward slashes with a drive letter, e.g.
#   /c/Work/Voltempo/fleet/EVerest
HOST_WORKSPACE_FOLDER=/path/to/EVerest
